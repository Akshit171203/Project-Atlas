# Copy to .env and fill in. Anything without a default here is required —
# the app fails fast at startup rather than booting misconfigured.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/atlas

# --- Models (local, downloaded on first run, no keys needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- LLM provider: "ollama" (local, free) or "gemini" ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_MAX_OUTPUT_TOKENS=500

# --- Auth ---
# REQUIRED, no default. Anyone holding this can forge a session token for
# any account, so treat it like a database password: never commit it, and
# use a different value per environment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

SESSION_COOKIE_NAME=atlas_token
# Must be false on plain-HTTP localhost or the browser drops the cookie
# silently. Set true anywhere it is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email verification ---
# Signed with a DIFFERENT secret from session tokens: a verification link
# travels through mail servers in plaintext, so a leak there must not be
# usable to mint a session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_TOKEN_SECRET=
EMAIL_TOKEN_EXPIRE_MINUTES=60

# Set false to let accounts sign in without confirming their address.
REQUIRE_EMAIL_VERIFICATION=true

# Where verification links point — the frontend, not the API.
FRONTEND_URL=http://localhost:3000

# Leave SMTP_HOST empty for development: the mailer then prints each
# message (including the verification link) to the backend console instead
# of sending it, so the whole flow works with no mail account.
# For Gmail, SMTP_PASSWORD must be an App Password, not the account
# password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Project Atlas <no-reply@localhost>
SMTP_STARTTLS=true
